# Copy to .env and edit. The bench reads this file (or the process env)
# for every default below; nothing in code is hardcoded to a host path.

# ── OpenAI-compatible LLM ───────────────────────────────────────────────
OPENAI_API_KEY=
DEFAULT_MODEL=gpt-5.4-mini

# ── Where bench output goes ─────────────────────────────────────────────
RESULTS_DIR=/tmp/os4agent-bench

# ── Task fixtures (downloaded by scripts/fetch_tasks.py) ────────────────
# FIXTURES_ROOT defaults to <bench>/_fixtures; OSWORLD_ROOT defaults to a
# subpath inside it. Override only if fixtures live elsewhere.
# FIXTURES_ROOT=/path/to/fixtures
# OSWORLD_ROOT=/path/to/OSWorld/evaluation_examples

# ── Container / VM images ───────────────────────────────────────────────
OSWORLD_IMAGE=localhost/ubuntu-webtop:test

# ── Snapshot driver paths ───────────────────────────────────────────────
PODMAN_BIN=podman
SSH_KEY=~/.ssh/id_ed25519
KVM_RUN_BASE=/tmp/os4agent-kvm
# BASE_DISK is required for KVM/KVM_VIRSH modes only. Point at the
# Ubuntu.qcow2 prepared with virt-customize (see README §"OSWorld VM").
# BASE_DISK=/var/lib/libvirt/images/Ubuntu.qcow2
# Per-workload overrides (optional). When set, take precedence over
# BASE_DISK for that workload; leave unset to share BASE_DISK.
# OSWORLD_BASE_DISK=/var/lib/libvirt/images/osworld-ubuntu.qcow2
